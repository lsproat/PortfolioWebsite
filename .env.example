# Server only. Reuse your existing Resend key; never add a VITE_ prefix.
RESEND_API_KEY=
CLOUDFLARE_TURNSTILE_SECRET_KEY=
# Bare authenticated sender address on your verified Resend domain.
RESEND_FROM_EMAIL=contact@example.com
# Private inbox, server only.
CONTACT_TO_EMAIL=inbox@example.com
# Public site key for a Managed Turnstile widget.
CLOUDFLARE_TURNSTILE_SITE_KEY=
